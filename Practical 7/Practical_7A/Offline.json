<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Offline</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background: linear-gradient(135deg,#0d6efd,#5b9cff);
        }

        .card {
            background: #fff;
            padding: 40px;
            width: 380px;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 8px 20px rgba(0,0,0,0.2);
        }

        .icon {
            font-size: 70px;
            margin-bottom: 15px;
        }

        h1 {
            color: #0d6efd;
            margin-bottom: 10px;
        }

        p {
            color: #555;
            line-height: 1.6;
            margin-bottom: 25px;
        }

        button {
            background: #0d6efd;
            color: white;
            border: none;
            padding: 12px 30px;
            font-size: 16px;
            border-radius: 8px;
            cursor: pointer;
            transition: 0.3s;
        }

            button:hover {
                background: #0b5ed7;
            }
    </style>
</head>
<body>

    <div class="card">
        <div class="icon">📡</div>

        <h1>You're Offline</h1>

        <p>
            Internet connection is unavailable.<br>
            Please check your network and try again.
        </p>

        <button onclick="location.reload()">
            Retry
        </button>
    </div>

</body>
</html>
